{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thuyainminnyo-hub/kmh-oia/blob/main/schemas/cybersecurity-threat-record.schema.json",
  "title": "KMH OIA Cybersecurity Threat Assessment Record",
  "description": "Evidence-led threat assessment contract. Schema validation does not prove source truth, authorization, remediation, or production readiness.",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "record_type", "threat", "asset", "assessment", "approval", "execution", "qa", "audit"],
  "properties": {
    "case_id": {"type": "string", "pattern": "^KMH-OIA-CYBER-[0-9]{4}-[0-9]{3,}$"},
    "record_type": {"const": "threat_assessment"},
    "threat": {
      "type": "object", "additionalProperties": false,
      "required": ["identifiers", "verification_status", "source_refs", "last_verified_at"],
      "properties": {
        "identifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^CVE-[0-9]{4}-[0-9]{4,}$"}},
        "verification_status": {"enum": ["pending", "verified", "disputed"]},
        "source_refs": {"type": "array", "items": {"type": "string", "format": "uri"}},
        "last_verified_at": {"type": ["string", "null"], "format": "date-time"},
        "affected_version_statement": {"type": ["string", "null"]},
        "fixed_version_statement": {"type": ["string", "null"]},
        "exploitation_status": {"enum": ["unknown", "not_reported", "reported", "confirmed"]}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "owner", "environment", "runtime_name", "runtime_version", "internet_exposed", "evidence_refs"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "owner": {"type": ["string", "null"]},
        "environment": {"enum": ["development", "test", "staging", "production", "unknown"]},
        "runtime_name": {"type": "string", "minLength": 1},
        "runtime_version": {"type": ["string", "null"]},
        "internet_exposed": {"type": ["boolean", "null"]},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["applicability", "impact", "likelihood", "confidence", "decision", "rationale", "evidence_refs", "assessed_at", "assessor"],
      "properties": {
        "applicability": {"enum": ["affected", "not_affected", "unknown"]},
        "impact": {"enum": ["low", "medium", "high", "critical", "unknown"]},
        "likelihood": {"enum": ["low", "medium", "high", "unknown"]},
        "confidence": {"enum": ["low", "medium", "high"]},
        "decision": {"enum": ["hold", "mitigate", "remediate", "monitor", "escalate"]},
        "rationale": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assessed_at": {"type": ["string", "null"], "format": "date-time"},
        "assessor": {"type": ["string", "null"]}
      }
    },
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "approver", "scope", "approved_at", "expires_at", "rollback_plan_ref"],
      "properties": {
        "status": {"enum": ["not_requested", "pending", "approved", "denied", "expired"]},
        "approver": {"type": ["string", "null"]},
        "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "approved_at": {"type": ["string", "null"], "format": "date-time"},
        "expires_at": {"type": ["string", "null"], "format": "date-time"},
        "rollback_plan_ref": {"type": ["string", "null"]}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "before_evidence_refs", "after_evidence_refs", "started_at", "finished_at", "result", "operator"],
      "properties": {
        "status": {"enum": ["not_started", "running", "completed", "failed", "rolled_back"]},
        "before_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "after_evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "started_at": {"type": ["string", "null"], "format": "date-time"},
        "finished_at": {"type": ["string", "null"], "format": "date-time"},
        "result": {"enum": ["not_started", "succeeded", "failed", "rolled_back"]},
        "operator": {"type": ["string", "null"]}
      }
    },
    "qa": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "reviewer", "findings", "evidence_refs"],
      "properties": {
        "status": {"enum": ["not_run", "pending", "passed", "failed"]},
        "reviewer": {"type": ["string", "null"]},
        "findings": {"type": "array", "items": {"type": "string"}},
        "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["events", "integrity_control_ref"],
      "properties": {
        "events": {"type": "array", "items": {
          "type": "object", "additionalProperties": false,
          "required": ["event_id", "actor", "action", "target", "timestamp", "evidence_refs"],
          "properties": {
            "event_id": {"type": "string", "minLength": 1},
            "actor": {"type": "string", "minLength": 1},
            "action": {"type": "string", "minLength": 1},
            "target": {"type": "string", "minLength": 1},
            "timestamp": {"type": "string", "format": "date-time"},
            "evidence_refs": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }},
        "integrity_control_ref": {"type": ["string", "null"]}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"threat": {"properties": {"verification_status": {"const": "verified"}}, "required": ["verification_status"]}}, "required": ["threat"]}, "then": {"properties": {"threat": {"properties": {"last_verified_at": {"type": "string", "format": "date-time"}, "source_refs": {"minItems": 1}}}}},
    {"if": {"properties": {"assessment": {"properties": {"applicability": {"const": "unknown"}}, "required": ["applicability"]}}, "required": ["assessment"]}, "then": {"properties": {"assessment": {"properties": {"decision": {"const": "hold"}}}}},
    {"if": {"properties": {"execution": {"properties": {"status": {"const": "completed"}}, "required": ["status"]}}, "required": ["execution"]}, "then": {"properties": {"execution": {"properties": {"before_evidence_refs": {"minItems": 1}, "after_evidence_refs": {"minItems": 1}, "result": {"const": "succeeded"}}}}},
    {"if": {"properties": {"qa": {"properties": {"status": {"const": "passed"}}, "required": ["status"]}}, "required": ["qa"]}, "then": {"properties": {"qa": {"properties": {"reviewer": {"type": "string", "minLength": 1}, "evidence_refs": {"minItems": 1}}}}},
    {"if": {"properties": {"approval": {"properties": {"status": {"const": "approved"}}, "required": ["status"]}}, "required": ["approval"]}, "then": {"properties": {"approval": {"properties": {"approver": {"type": "string", "minLength": 1}, "scope": {"minItems": 1}, "approved_at": {"type": "string", "format": "date-time"}, "expires_at": {"type": "string", "format": "date-time"}, "rollback_plan_ref": {"type": "string", "minLength": 1}}}}}
  ]
}
