{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kmh.example/schemas/agent-record.schema.json",
  "title": "KMH AION OS Agent Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["agent_id", "name", "role", "owner", "version", "capabilities", "status"],
  "properties": {
    "agent_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"},
    "name": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "status": {"type": "string", "enum": ["ACTIVE", "SUSPENDED", "DEPRECATED", "REVOKED"]},
    "description": {"type": "string"}
  }
}
