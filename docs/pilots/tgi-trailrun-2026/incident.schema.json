{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/thuyainminnyo-hub/kmh-oia/blob/main/docs/pilots/tgi-trailrun-2026/incident.schema.json",
  "title": "KMH OIA TGiTrailRun Runner Safety Incident",
  "description": "Minimal privacy-conscious incident contract. Use pseudonymous IDs; never include names, phone numbers, diagnosis, or free-text medical details.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "incident_id",
    "event_id",
    "event_type",
    "severity",
    "status",
    "occurred_at",
    "recorded_at",
    "runner_id",
    "checkpoint_id",
    "reported_by_role",
    "summary_code",
    "audit"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "incident_id": {
      "type": "string",
      "pattern": "^inc_[A-Za-z0-9_-]{8,64}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^evt_[A-Za-z0-9_-]{8,64}$",
      "description": "Client idempotency key; unique within the event scope."
    },
    "event_type": {
      "type": "string",
      "enum": ["runner_assistance_requested", "runner_unaccounted_for", "injury_reported", "environmental_hazard", "other_safety_incident"]
    },
    "severity": {
      "type": "string",
      "enum": ["P1", "P2", "P3"],
      "description": "Operational urgency assigned by an authorized human; not an automated medical triage result."
    },
    "status": {
      "type": "string",
      "enum": ["REPORTED", "ACKNOWLEDGED", "DISPATCHED", "RESOLVED", "CLOSED"]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "runner_id": {
      "type": "string",
      "pattern": "^run_[A-Za-z0-9_-]{4,64}$"
    },
    "checkpoint_id": {
      "type": "string",
      "pattern": "^cp_[A-Za-z0-9_-]{2,64}$"
    },
    "last_known_location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "observed_at"],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "reported_by_role": {
      "type": "string",
      "enum": ["race_control", "checkpoint_volunteer", "medical_lead", "rescue_coordinator", "authorized_runner"]
    },
    "assigned_to_role": {
      "type": "string",
      "enum": ["race_control", "medical_team", "rescue_team", "checkpoint_lead"]
    },
    "summary_code": {
      "type": "string",
      "enum": ["NEEDS_CHECK", "INJURY_REPORTED", "NOT_REACHED_CHECKPOINT", "ROUTE_HAZARD", "WITHDRAWAL_SUPPORT", "OTHER"]
    },
    "operator_note": {
      "type": "string",
      "maxLength": 300,
      "description": "Operational note only; no names, contact details, diagnosis, or unnecessary health information."
    },
    "audit": {
      "type": "array",
      "minItems": 1,
      "description": "For create requests, the service accepts one initial REPORTED entry; persisted records may contain additional service-appended audit entries.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "actor_role", "at", "result"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["REPORTED", "ACKNOWLEDGED", "DISPATCHED", "RESOLVED", "CLOSED", "TRANSITION_REJECTED", "NOTIFICATION_FAILED"]
          },
          "actor_role": {
            "type": "string",
            "enum": ["race_control", "checkpoint_volunteer", "medical_lead", "rescue_coordinator", "medical_team", "rescue_team", "checkpoint_lead", "system"]
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "type": "string",
            "enum": ["accepted", "rejected", "pending", "failed", "completed"]
          },
          "correlation_id": {
            "type": "string",
            "maxLength": 128
          }
        }
      }
    }
  }
}
